# Postgres (usado pelo docker-compose para o container do banco)
POSTGRES_DB=sabemi_webhooks
POSTGRES_USER=sabemi
POSTGRES_PASSWORD=sabemi_dev_password

# Backend (.NET) - sobrescreve appsettings.json via variáveis de ambiente
# (os valores abaixo já são o padrão em appsettings.Development.json)
ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=sabemi_webhooks;Username=sabemi;Password=sabemi_dev_password
WebhookSeguranca__ApiKey=dev-api-key-local
WebhookSeguranca__SegredoAssinatura=dev-segredo-local-para-hmac

# Frontend (Vite) - URL base da API
# Use 127.0.0.1 (não "localhost"): em WSL com rede mirrored, "localhost" pode tentar
# IPv6 primeiro e demorar ~20s até cair para IPv4.
VITE_API_BASE_URL=http://127.0.0.1:5166
